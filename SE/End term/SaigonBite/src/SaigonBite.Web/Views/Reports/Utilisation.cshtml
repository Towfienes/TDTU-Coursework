@model HubUtilisationReport
@{
    ViewData["Title"] = L["Reports.UtilisationTitle"].Value;
    var from = (DateOnly)ViewData["From"]!;
    var to = (DateOnly)ViewData["To"]!;
}

<div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
    <div>
        <p class="eyebrow mb-1">R2 · @L["Reports.Title"]</p>
        <h1 class="h2 mb-1">@L["Reports.UtilisationTitle"]</h1>
        <p class="panel-sub mb-0">@L["Reports.UtilisationSub"] <span class="br-ref">FR-R2</span></p>
    </div>
    <a class="btn btn-sm btn-outline-ink" asp-controller="Admin" asp-action="Index">@L["Nav.Dashboard"]</a>
</div>

<section class="panel mb-4">
    <form method="get" asp-controller="Reports" asp-action="Utilisation" class="row g-3 align-items-end">
        <div class="col-12 col-sm-4">
            <label class="form-label" for="from">@L["Common.From"]</label>
            <input class="form-control" id="from" name="from" type="date" value="@from.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-12 col-sm-4">
            <label class="form-label" for="to">@L["Common.To"]</label>
            <input class="form-control" id="to" name="to" type="date" value="@to.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-12 col-sm-4">
            <button type="submit" class="btn btn-ember">@L["Common.Apply"]</button>
        </div>
    </form>
</section>

<div class="panel p-0 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-ink align-middle mb-0">
            <caption class="visually-hidden">@L["Reports.UtilisationTitle"]</caption>
            <thead>
                <tr>
                    <th scope="col">@L["Common.Hub"]</th>
                    <th scope="col" class="text-end">@L["Reports.OrdersHandled"]</th>
                    <th scope="col" class="text-end">@L["Reports.AvgPrep"]</th>
                    <th scope="col" class="text-end">@L["Reports.CurrentLoad"]</th>
                    <th scope="col" class="text-end">@L["Reports.QuietKitchen"]</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var row in Model.Rows)
            {
                <tr>
                    <td>
                        <span class="fw-semibold d-block">@row.HubName</span>
                        <span class="menu-meta">
                            @row.District · @L["Hubs.Capacity"] @row.KitchenCapacity
                            @if (row.IsDeleted)
                            {
                                <span class="status-badge status-cancelled ms-1">@L["Common.Deleted"]</span>
                            }
                        </span>
                    </td>
                    <td class="text-end">@row.OrdersHandled</td>
                    <td class="text-end">@row.AveragePreparationMinutes.ToString("0.0") min</td>
                    <td class="text-end">
                        <span class="load-value @(row.CurrentLoadPercent >= 90 ? "text-ember" : "")">
                            @row.CurrentLoadPercent%
                        </span>
                    </td>
                    <td class="text-end">@row.QuietKitchenCount</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<div class="row g-3 mt-1">
    <div class="col-12 col-sm-6 col-xl-4">
        <div class="panel">
            <p class="kpi-label mb-1">@L["Reports.RefusingHubs"]</p>
            <p class="kpi mb-0">@Model.RefusingHubCount</p>
            <p class="panel-sub mb-0">@L["Reports.RefusingHubsSub"] <span class="br-ref">BR8</span></p>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-4">
        <div class="panel">
            <p class="kpi-label mb-1">@L["Reports.QuietKitchen"]</p>
            <p class="kpi mb-0">@Model.Rows.Sum(r => r.QuietKitchenCount)</p>
            <p class="panel-sub mb-0">@L["Reports.QuietKitchenSub"] <span class="br-ref">BR7</span></p>
        </div>
    </div>
    <div class="col-12 col-xl-4">
        <div class="panel">
            <p class="kpi-label mb-1">@L["Reports.Range"]</p>
            <p class="mb-0 fw-semibold">@from.ToString("dd/MM/yyyy") – @to.ToString("dd/MM/yyyy")</p>
        </div>
    </div>
</div>

<p class="panel-sub mt-3 mb-0">@L["Reports.UtilisationNote"] <span class="br-ref">FR-R2 · NFR5</span></p>
