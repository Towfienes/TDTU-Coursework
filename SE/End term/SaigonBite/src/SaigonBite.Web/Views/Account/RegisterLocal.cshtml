@model RegisterLocalVm
@{
    ViewData["Title"] = L["Account.RegisterLocal"].Value;
}

<div class="row justify-content-center">
    <div class="col-12 col-md-10 col-lg-7 col-xl-6">
        <section class="panel">
            <p class="eyebrow mb-2">@L["Account.LocalEyebrow"]</p>
            <h1 class="h3 mb-1">@L["Account.RegisterLocal"]</h1>
            <p class="panel-sub mb-3">@L["Account.LocalSub"]</p>

            <form asp-controller="Account" asp-action="RegisterLocal" method="post" novalidate>
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="mb-3">
                    <label class="form-label" asp-for="Mobile">@L["Account.Mobile"]</label>
                    <input class="form-control" asp-for="Mobile" inputmode="numeric" autocomplete="tel" />
                    <div class="form-text">@L["Account.MobileHint"]</div>
                </div>

                <div class="mb-3">
                    <label class="form-label" asp-for="DisplayName">@L["Account.DisplayName"]</label>
                    <input class="form-control" asp-for="DisplayName" autocomplete="name" />
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-12 col-sm-6">
                        <label class="form-label" asp-for="Password">@L["Account.Password"]</label>
                        <input class="form-control" asp-for="Password" type="password" autocomplete="new-password" />
                    </div>
                    <div class="col-12 col-sm-6">
                        <label class="form-label" asp-for="ConfirmPassword">@L["Account.ConfirmPassword"]</label>
                        <input class="form-control" asp-for="ConfirmPassword" type="password" autocomplete="new-password" />
                    </div>
                </div>

                <p class="panel-sub mb-3">@L["Account.PasswordHint"]</p>

                <button type="submit" class="btn btn-ember w-100">@L["Account.SendOtp"]</button>
            </form>
        </section>
    </div>
</div>
