@model VoucherFormVm
@{
    ViewData["Title"] = L["Common.Edit"] + " · " + Model.Code;
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-9 col-xl-7">
        <section class="panel">
            <p class="eyebrow mb-2">@L["UseCaseC"]</p>
            <h1 class="h3 mb-1">@L["Common.Edit"] · @Model.Code</h1>
            <p class="panel-sub mb-3">@L["Vouchers.EditSub"]</p>

            <form asp-controller="Vouchers" asp-action="Edit" asp-route-id="@Model.Id" method="post" novalidate>
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="row g-3 mb-3">
                    <div class="col-12 col-sm-5">
                        <label class="form-label" asp-for="Code">@L["Vouchers.Code"]</label>
                        <input class="form-control text-uppercase" asp-for="Code" />
                    </div>
                    <div class="col-12 col-sm-4">
                        <label class="form-label" asp-for="Type">@L["Vouchers.Type"]</label>
                        <select class="form-select" asp-for="Type" asp-items="Html.GetEnumSelectList<VoucherType>()"></select>
                    </div>
                    <div class="col-12 col-sm-3">
                        <label class="form-label" asp-for="Value">@L["Vouchers.Value"]</label>
                        <input class="form-control" asp-for="Value" type="number" min="1" />
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-12 col-sm-4">
                        <label class="form-label" asp-for="MaxDiscount">@L["Vouchers.Cap"] (₫)</label>
                        <input class="form-control" asp-for="MaxDiscount" type="number" min="0" step="1000" />
                    </div>
                    <div class="col-12 col-sm-4">
                        <label class="form-label" asp-for="MinSubtotal">@L["Vouchers.MinSubtotal"] (₫)</label>
                        <input class="form-control" asp-for="MinSubtotal" type="number" min="0" step="1000" />
                    </div>
                    <div class="col-12 col-sm-4">
                        <label class="form-label" asp-for="ValidFrom">@L["Vouchers.ValidFrom"]</label>
                        <input class="form-control" asp-for="ValidFrom" type="date" />
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-12 col-sm-6">
                        <label class="form-label" asp-for="ValidTo">@L["Vouchers.ValidTo"]</label>
                        <input class="form-control" asp-for="ValidTo" type="date" />
                    </div>
                    <div class="col-12 col-sm-6 d-flex align-items-end">
                        <div class="form-check mb-2">
                            <input class="form-check-input" asp-for="IsActive" />
                            <label class="form-check-label" asp-for="IsActive">@L["Vouchers.Active"]</label>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-ember">@L["Common.Save"]</button>
                    <a class="btn btn-outline-ink" asp-controller="Vouchers" asp-action="Index">@L["Common.Cancel"]</a>
                </div>
            </form>
        </section>
    </div>
</div>
