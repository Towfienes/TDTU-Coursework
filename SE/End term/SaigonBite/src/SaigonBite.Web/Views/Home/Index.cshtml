@model HomePageVm
@{
    ViewData["Title"] = L["Home.Title"].Value;
}

<section class="hero mb-4">
    <p class="eyebrow mb-2">@L["Home.Eyebrow"]</p>
    <h1>@L["Home.HeroTitle"]</h1>
    <p class="hero-lead mb-4">@L["Home.HeroLead"]</p>

    <div class="d-flex flex-wrap gap-2 mb-4">
        <a class="btn btn-ember" asp-controller="Brands" asp-action="Index">@L["Home.BrowseMenu"]</a>
        <a class="btn btn-outline-ink" asp-controller="Account" asp-action="RegisterTourist">@L["Home.TouristSignup"]</a>
        <a class="btn btn-outline-ink" asp-controller="Hubs" asp-action="Index">@L["Home.SeeHubs"]</a>
    </div>

    <div class="d-flex flex-wrap gap-3 align-items-center">
        <span class="badge-soft">@L["Home.Badge.Load"]</span>
        <span class="badge-soft">@L["Home.Badge.Lifecycle"]</span>
        <span class="badge-soft">@L["Home.Badge.Payments"]</span>
        @if (Model.RainFlag)
        {
            <span class="badge-soft text-ember">@L["Home.RainOn"]</span>
        }
        else
        {
            <span class="badge-soft">@L["Home.RainOff"]</span>
        }
    </div>
</section>

<section class="mb-5">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
        <div>
            <h2 class="h3 mb-1">@L["Home.HubsTitle"]</h2>
            <p class="panel-sub mb-0">@L["Home.HubsSub"]</p>
        </div>
        <span class="muted-label">@L["Hubs.Load"] · BR8</span>
    </div>

    <div class="row g-3">
        @foreach (var row in Model.Hubs)
        {
            var meterClass = row.LoadPercent >= 90 ? "is-full" : row.LoadPercent >= 60 ? "is-warm" : "";
            <div class="col-12 col-md-6 col-xl-4">
                <article class="panel hub-card">
                    <p class="district mb-1">@row.Hub.District</p>
                    <h3 class="h5 mb-1">@row.Hub.Name</h3>
                    <p class="panel-sub mb-3">@row.Hub.Address</p>

                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="small">@L["Hubs.Load"]</span>
                        <span class="load-value">@row.LoadPercent%</span>
                    </div>
                    <div class="load-meter @meterClass mb-2" role="img"
                         aria-label="@L["Hubs.Load"] @row.LoadPercent%">
                        <span style="width:@(Math.Min(row.LoadPercent, 100))%"></span>
                    </div>
                    <p class="panel-sub mb-3">
                        @row.BusyOrders / @row.Hub.KitchenCapacity @L["Hubs.BusySlots"]
                    </p>

                    @if (row.IsFull)
                    {
                        <p class="small text-ember mb-3">@L["Hubs.FullNotice"]</p>
                    }

                    <div class="mt-auto d-flex gap-2">
                        <a class="btn btn-sm btn-ember" asp-controller="Brands" asp-action="Index"
                           asp-route-hubId="@row.Hub.Id">@L["Home.OrderHere"]</a>
                        @if (User.IsInRole(Roles.Admin))
                        {
                            <a class="btn btn-sm btn-outline-ink" asp-controller="Hubs" asp-action="Edit"
                               asp-route-id="@row.Hub.Id">@L["Common.Edit"]</a>
                        }
                    </div>
                </article>
            </div>
        }
    </div>
</section>

<section>
    <div class="mb-3">
        <h2 class="h3 mb-1">@L["Home.BrandsTitle"]</h2>
        <p class="panel-sub mb-0">@L["Home.BrandsSub"]</p>
    </div>
    <div class="row g-3">
        @foreach (var brand in Model.Brands)
        {
            <div class="col-12 col-md-6 col-xl-4">
                <article class="panel h-100">
                    <h3 class="h6 mb-1">@brand.Name</h3>
                    <p class="panel-sub mb-0">@brand.Description</p>
                </article>
            </div>
        }
    </div>
</section>

@if (User.Identity?.IsAuthenticated != true)
{
    <section class="panel mt-5">
        <h2 class="h5 mb-2">@L["Home.LoginHintTitle"]</h2>
        <p class="panel-sub mb-3">@L["Home.LoginHint"]</p>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-sm btn-ember" asp-controller="Account" asp-action="RegisterLocal">@L["Account.RegisterLocal"]</a>
            <a class="btn btn-sm btn-outline-ink" asp-controller="Account" asp-action="RegisterTourist">@L["Account.RegisterTourist"]</a>
            <a class="btn btn-sm btn-outline-ink" asp-controller="Account" asp-action="Login">@L["Nav.Login"]</a>
        </div>
    </section>
}
