@model BrandFormVm
@{
    ViewData["Title"] = L["Brands.NewBrand"].Value;
    var hubs = ViewData["Hubs"] as List<Hub> ?? new List<Hub>();
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8 col-xl-6">
        <section class="panel">
            <p class="eyebrow mb-2">@L["UseCaseA"]</p>
            <h1 class="h3 mb-1">@L["Brands.NewBrand"]</h1>
            <p class="panel-sub mb-3">@L["Brands.NewBrandSub"]</p>

            <form asp-controller="Brands" asp-action="Create" method="post" novalidate>
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="mb-3">
                    <label class="form-label" asp-for="Name">@L["Common.Name"]</label>
                    <input class="form-control" asp-for="Name" />
                </div>

                <div class="mb-3">
                    <label class="form-label" asp-for="Description">@L["Common.Description"]</label>
                    <textarea class="form-control" asp-for="Description" rows="3"></textarea>
                </div>

                <fieldset class="mb-3">
                    <legend class="form-label">@L["Brands.OperatingHubs"] <span class="br-ref">FR-A1 · BR12</span></legend>
                    @if (hubs.Count == 0)
                    {
                        <p class="panel-sub mb-0">@L["Brands.NoHubsYet"]</p>
                    }
                    else
                    {
                        foreach (var hub in hubs)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="HubIds" value="@hub.Id"
                                       id="hub-@hub.Id" checked="@Model.HubIds.Contains(hub.Id)" />
                                <label class="form-check-label" for="hub-@hub.Id">
                                    @hub.Name — @hub.District
                                </label>
                            </div>
                        }
                    }
                </fieldset>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-ember">@L["Common.Create"]</button>
                    <a class="btn btn-outline-ink" asp-controller="Brands" asp-action="Index">@L["Common.Cancel"]</a>
                </div>
            </form>
        </section>
    </div>
</div>
