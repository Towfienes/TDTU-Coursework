@model Brand
@{
    ViewData["Title"] = Model.Name;
    var isAdmin = User.IsInRole(Roles.Admin);
}

<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
    <div>
        <p class="eyebrow mb-1">@L["Brands.Eyebrow"]</p>
        <h1 class="h2 mb-1">@Model.Name</h1>
        <p class="panel-sub mb-0">@Model.Description</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-sm btn-outline-ink" asp-controller="Brands" asp-action="Index">@L["Common.Back"]</a>
        @if (isAdmin)
        {
            <a class="btn btn-sm btn-ember" asp-controller="Brands" asp-action="Edit" asp-route-id="@Model.Id">@L["Common.Edit"]</a>
            <a class="btn btn-sm btn-outline-ink" asp-controller="Brands" asp-action="CreateItem" asp-route-brandId="@Model.Id">@L["Brands.NewItem"]</a>
        }
    </div>
</div>

<section class="panel mb-4">
    <h2 class="h5 mb-2">@L["Brands.OperatingHubs"]</h2>
    <div class="d-flex flex-wrap gap-2">
        @foreach (var link in Model.HubBrands)
        {
            <span class="badge-soft">@link.Hub?.Name — @link.Hub?.District</span>
        }
    </div>
</section>

<section>
    <h2 class="h5 mb-3">@L["Brands.Items"]</h2>

    @if (Model.MenuItems.Count == 0)
    {
        <div class="empty-state">@L["Brands.NoItems"]</div>
    }
    else
    {
        <div class="panel p-0 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-ink mb-0 align-middle">
                    <thead>
                        <tr>
                            <th scope="col">@L["Common.Item"]</th>
                            <th scope="col">@L["Common.Category"]</th>
                            <th scope="col" class="text-end">@L["Common.Price"]</th>
                            <th scope="col">@L["Common.Availability"]</th>
                            @if (isAdmin)
                            {
                                <th scope="col" class="text-end">@L["Common.Actions"]</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model.MenuItems.OrderBy(m => m.Category).ThenBy(m => m.Name))
                    {
                        <tr>
                            <td class="fw-semibold">@item.Name</td>
                            <td>@item.Category</td>
                            <td class="text-end money">@Money.Vnd(item.Price)</td>
                            <td>
                                @if (item.IsAvailable)
                                {
                                    <span class="status-badge status-delivered">@L["Common.Available"]</span>
                                }
                                else
                                {
                                    <span class="status-badge status-cancelled">@L["Common.Unavailable"]</span>
                                }
                            </td>
                            @if (isAdmin)
                            {
                                <td class="text-end">
                                    <div class="d-inline-flex flex-wrap gap-1 justify-content-end">
                                        <a class="btn btn-sm btn-outline-ink" asp-controller="Brands" asp-action="EditItem"
                                           asp-route-id="@item.Id">@L["Common.Edit"]</a>
                                        <form asp-controller="Brands" asp-action="ToggleAvailability" method="post" class="m-0">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-ink">
                                                @(item.IsAvailable ? L["Brands.MarkUnavailable"] : L["Brands.MarkAvailable"])
                                            </button>
                                        </form>
                                        <form asp-controller="Brands" asp-action="DeleteItem" method="post" class="m-0">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-ink">@L["Common.Delete"]</button>
                                        </form>
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
        @if (isAdmin)
        {
            <p class="panel-sub mt-2 mb-0">@L["Brands.SoftDeleteNote"]</p>
        }
    }
</section>

@if (isAdmin)
{
    <section class="panel mt-4">
        <h2 class="h6 mb-2">@L["Brands.DangerZone"]</h2>
        <form asp-controller="Brands" asp-action="Delete" method="post" class="m-0">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <button type="submit" class="btn btn-sm btn-outline-ink">@L["Brands.DeleteBrand"]</button>
        </form>
        <p class="panel-sub mt-2 mb-0">@L["Brands.DeleteBrandNote"]</p>
    </section>
}
